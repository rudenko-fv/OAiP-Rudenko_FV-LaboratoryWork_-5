using System;

namespace Lab5_Task2_10
{
    class Time
    {
        private int hours, minutes, seconds;

        public Time(int h, int m, int s)
        {
            int total = h * 3600 + m * 60 + s;
            hours = total / 3600;
            minutes = (total % 3600) / 60;
            seconds = total % 60;
        }

        public int ToSeconds()
        {
            return hours * 3600 + minutes * 60 + seconds;
        }

        public int ToMinutes()
        {
            return (int)Math.Round(ToSeconds() / 60.0);
        }

        public int Difference(Time other)
        {
            return Math.Abs(this.ToSeconds() - other.ToSeconds());
        }

        public Time AddSeconds(int sec)
        {
            return new Time(0, 0, this.ToSeconds() + sec);
        }

        public Time SubtractSeconds(int sec)
        {
            int result = this.ToSeconds() - sec;
            if (result < 0) result = 0;
            return new Time(0, 0, result);
        }

        public int CompareTo(Time other)
        {
            int t1 = this.ToSeconds();
            int t2 = other.ToSeconds();
            if (t1 > t2) return 1;
            if (t1 < t2) return -1;
            return 0;
        }

        public override string ToString()
        {
            return $"{hours:D2}:{minutes:D2}:{seconds:D2}";
        }
    }

    class Program
    {
        static void Main()
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;
            Console.WriteLine("=== Задание 2-10: Класс Time ===\n");

            
            Console.WriteLine("--- Ввод времени 1 ---");
            Console.Write("Часы: ");
            int h1 = int.Parse(Console.ReadLine());
            Console.Write("Минуты: ");
            int m1 = int.Parse(Console.ReadLine());
            Console.Write("Секунды: ");
            int s1 = int.Parse(Console.ReadLine());

            Time t1 = new Time(h1, m1, s1);

            
            Console.WriteLine("\n--- Ввод времени 2 ---");
            Console.Write("Часы: ");
            int h2 = int.Parse(Console.ReadLine());
            Console.Write("Минуты: ");
            int m2 = int.Parse(Console.ReadLine());
            Console.Write("Секунды: ");
            int s2 = int.Parse(Console.ReadLine());

            Time t2 = new Time(h2, m2, s2);

            
            Console.WriteLine($"\n=== Результаты ===");
            Console.WriteLine($"Время 1: {t1}");
            Console.WriteLine($"Время 2: {t2}");
            Console.WriteLine($"Время 1 в секундах: {t1.ToSeconds()} сек.");
            Console.WriteLine($"Время 1 в минутах: {t1.ToMinutes()} мин.");
            Console.WriteLine($"Разница: {t1.Difference(t2)} сек.");
            Console.WriteLine($"Плюс 300 сек: {t1.AddSeconds(300)}");
            Console.WriteLine($"Минус 100 сек: {t1.SubtractSeconds(100)}");

            int cmp = t1.CompareTo(t2);
            Console.Write($"Сравнение: ");
            if (cmp > 0) Console.WriteLine("Время 1 больше");
            else if (cmp < 0) Console.WriteLine("Время 1 меньше");
            else Console.WriteLine("Времена равны");

            Console.ReadKey();
        }
    }
}
